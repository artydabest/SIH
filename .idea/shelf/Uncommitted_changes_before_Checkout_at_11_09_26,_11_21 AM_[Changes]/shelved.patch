<+>package com.sih.myapplication;\n\nimport android.content.Context;\nimport android.content.Intent;\nimport android.net.Uri;\nimport android.os.Bundle;\nimport android.view.LayoutInflater;\nimport android.view.View;\nimport android.view.ViewGroup;\nimport android.widget.Button;\nimport android.widget.TextView;\nimport android.widget.Toast;\nimport androidx.annotation.NonNull;\nimport androidx.appcompat.app.AppCompatActivity;\nimport androidx.recyclerview.widget.LinearLayoutManager;\nimport androidx.recyclerview.widget.RecyclerView;\nimport java.util.ArrayList;\nimport java.util.List;\n\npublic class VolunteersActivity extends AppCompatActivity {\n\n    private Button btnBack;\n    private TextView tvVolunteerCount;\n    private RecyclerView rvVolunteers;\n    private VolunteerAdapter adapter;\n    private List<Volunteer> volunteerList;\n\n    @Override\n    protected void onCreate(Bundle savedInstanceState) {\n        super.onCreate(savedInstanceState);\n        setContentView(R.layout.activity_volunteers);\n\n        initViews();\n        loadDummyVolunteers();\n        setupRecyclerView();\n    }\n\n    private void initViews() {\n        btnBack = findViewById(R.id.btnBack);\n        tvVolunteerCount = findViewById(R.id.tvVolunteerCount);\n        rvVolunteers = findViewById(R.id.rvVolunteers);\n\n        btnBack.setOnClickListener(new View.OnClickListener() {\n            @Override\n            public void onClick(View v) {\n                finish();\n            }\n        });\n    }\n\n    private void loadDummyVolunteers() {\n        volunteerList = new ArrayList<>();\n        volunteerList.add(new Volunteer(\"Rahul Sharma\", \"Certified First Responder\", \"350 m away\", \"Available now • Has Medical Kit\", \"+919876543210\"));\n        volunteerList.add(new Volunteer(\"Priya Nair\", \"Search & Rescue Volunteer\", \"620 m away\", \"Available now • Equipped with Stretcher\", \"+919876543211\"));\n        volunteerList.add(new Volunteer(\"Arjun Patel\", \"Disaster Relief Coordinator\", \"950 m away\", \"Standby • Mesh Relay Anchor\", \"+919876543212\"));\n\n        tvVolunteerCount.setText(volunteerList.size() + \" Online\");\n    }\n\n    private void setupRecyclerView() {\n        adapter = new VolunteerAdapter(this, volunteerList);\n        rvVolunteers.setLayoutManager(new LinearLayoutManager(this));\n        rvVolunteers.setAdapter(adapter);\n    }\n\n    // --- Model Class ---\n    public static class Volunteer {\n        private String name, role, distance, availability, phone;\n\n        public Volunteer(String name, String role, String distance, String availability, String phone) {\n            this.name = name;\n            this.role = role;\n            this.distance = distance;\n            this.availability = availability;\n            this.phone = phone;\n        }\n\n        public String getName() { return name; }\n        public String getRole() { return role; }\n        public String getDistance() { return distance; }\n        public String getAvailability() { return availability; }\n        public String getPhone() { return phone; }\n    }\n\n    // --- RecyclerView Adapter ---\n    public static class VolunteerAdapter extends RecyclerView.Adapter<VolunteerAdapter.ViewHolder> {\n        private final Context context;\n        private final List<Volunteer> volunteerList;\n\n        public VolunteerAdapter(Context context, List<Volunteer> volunteerList) {\n            this.context = context;\n            this.volunteerList = volunteerList;\n        }\n\n        @NonNull\n        @Override\n        public ViewHolder onCreateViewHolder(@NonNull ViewGroup parent, int viewType) {\n            View view = LayoutInflater.from(context).inflate(R.layout.item_volunteer, parent, false);\n            return new ViewHolder(view);\n        }\n\n        @Override\n        public void onBindViewHolder(@NonNull ViewHolder holder, int position) {\n            Volunteer volunteer = volunteerList.get(position);\n            holder.tvVolunteerName.setText(volunteer.getName());\n            holder.tvVolunteerRole.setText(volunteer.getRole());\n            holder.tvVolunteerDistance.setText(volunteer.getDistance());\n            holder.tvVolunteerAvailability.setText(\"● \" + volunteer.getAvailability());\n\n            holder.btnContactVolunteer.setOnClickListener(new View.OnClickListener() {\n                @Override\n                public void onClick(View v) {\n                    Intent dialIntent = new Intent(Intent.ACTION_DIAL);\n                    dialIntent.setData(Uri.parse(\"tel:\" + volunteer.getPhone()));\n                    if (dialIntent.resolveActivity(context.getPackageManager()) != null) {\n                        context.startActivity(dialIntent);\n                    } else {\n                        Toast.makeText(context, \"Contacting \" + volunteer.getName() + \" (\" + volunteer.getPhone() + \")\", Toast.LENGTH_SHORT).show();\n                    }\n                }\n            });\n        }\n\n        @Override\n        public int getItemCount() {\n            return volunteerList.size();\n        }\n\n        public static class ViewHolder extends RecyclerView.ViewHolder {\n            TextView tvVolunteerName, tvVolunteerRole, tvVolunteerDistance, tvVolunteerAvailability;\n            Button btnContactVolunteer;\n\n            public ViewHolder(@NonNull View itemView) {\n                super(itemView);\n                tvVolunteerName = itemView.findViewById(R.id.tvVolunteerName);\n                tvVolunteerRole = itemView.findViewById(R.id.tvVolunteerRole);\n                tvVolunteerDistance = itemView.findViewById(R.id.tvVolunteerDistance);\n                tvVolunteerAvailability = itemView.findViewById(R.id.tvVolunteerAvailability);\n                btnContactVolunteer = itemView.findViewById(R.id.btnContactVolunteer);\n            }\n        }\n    }\n}
