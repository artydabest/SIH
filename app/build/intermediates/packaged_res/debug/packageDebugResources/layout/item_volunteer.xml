<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Avatar Icon -->
        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="#F1EAFE"
            android:gravity="center"
            android:text="🧑‍🚒"
            android:textSize="22sp"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvVolunteerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rahul Sharma"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVolunteerRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Certified First Responder"
                android:textColor="@color/volunteer_purple"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Distance Badge -->
        <TextView
            android:id="@+id/tvVolunteerDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#F3F4F6"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="350 m away"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/tvVolunteerAvailability"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="● Available now • Has Medical Kit"
            android:textColor="@color/safe_green"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Contact Button -->
        <Button
            android:id="@+id/btnContactVolunteer"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="📞 CONTACT"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="@color/volunteer_purple"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />
    </LinearLayout>
</LinearLayout>