<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Disaster Rescue"
            android:textColor="#17202A"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Safe Places + Volunteers"
            android:textColor="#5F6B76"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="YOUR LOCATION"
            android:textColor="#2E7D32"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/locationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:text="Getting your GPS location..."
            android:textColor="#17202A"
            android:textSize="16sp" />

        <Button
            android:id="@+id/refreshButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Refresh Location"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/sosButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#D32F2F"
            android:text="SOS — Alert Responders"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/incidentStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:text="Connecting to shared network…"
            android:textColor="#5F6B76"
            android:textSize="13sp" />
        <WebView
            android:id="@+id/rescueMapWebView"
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:layout_marginTop="16dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="NEAREST SAFE PLACES"
            android:textColor="#1565C0"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/safePlacesText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:lineSpacingExtra="6dp"
            android:padding="16dp"
            android:text="Calculating..."
            android:textColor="#17202A"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="NEAREST AVAILABLE VOLUNTEERS"
            android:textColor="#E65100"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/volunteersText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:lineSpacingExtra="6dp"
            android:padding="16dp"
            android:text="Calculating..."
            android:textColor="#17202A"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"
            android:text="Prototype mode: safe places and volunteers currently use test coordinates."
            android:textColor="#6B7280"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
