<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header row: title + settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Disaster Rescue"
                    android:textColor="#17202A"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Live map · safe spots · volunteers · friends"
                    android:textColor="#5F6B76"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/settingsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="⚙"
                android:textAllCaps="false"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- LIVE MAP (MapLibre — open-source, no Google Maps) -->
        <org.maplibre.android.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="12dp"
            android:background="#E1E7ED" />

        <!-- Legend for the map -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="🔵 You   🟢 Friend safe   🔴 Friend needs help   🟦 Volunteer   🟩 Safe spot"
            android:textColor="#5F6B76"
            android:textSize="11sp" />

        <!-- PERSISTENT DISASTER ALERT BANNER (stays visible while alert is active) -->
        <LinearLayout
            android:id="@+id/alertBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#C62828"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/alertBannerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🚨 EARTHQUAKE ALERT"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/alertBannerMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="What you should do:"
                android:textColor="#FFCDD2"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="WHAT YOU SHOULD DO:"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/alertBannerInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="YOUR LOCATION"
            android:textColor="#2E7D32"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/locationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:text="Getting your GPS location..."
            android:textColor="#17202A"
            android:textSize="15sp" />

        <Button
            android:id="@+id/refreshButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Refresh Location &amp; Data"
            android:textAllCaps="false" />

        <!-- SAFETY STATUS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="MY SAFETY STATUS"
            android:textColor="#1565C0"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/safeToggleButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#2E7D32"
            android:text="I am SAFE"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/checkinStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Check-ins share your location so friends see you."
            android:textColor="#5F6B76"
            android:textSize="12sp" />

        <!-- EMERGENCY -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="EMERGENCY"
            android:textColor="#C62828"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/sosButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#C62828"
            android:text="SOS — Report Emergency"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/sosStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Press SOS to alert responders with your location."
            android:textColor="#5F6B76"
            android:textSize="12sp" />

        <!-- SAFE PLACES -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="NEAREST SAFE SPOTS (tap for directions)"
            android:textColor="#1565C0"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/safePlacesText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:text="Loading..."
            android:textColor="#17202A"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/safePlacesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <!-- VOLUNTEERS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="NEARBY VOLUNTEERS (tap to call)"
            android:textColor="#E65100"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/volunteersText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:text="Loading..."
            android:textColor="#17202A"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/volunteersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <!-- FRIENDS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="FRIENDS — LIVE STATUS"
            android:textColor="#6A1B9A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/friendsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:text="Loading..."
            android:textColor="#17202A"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/friendsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
